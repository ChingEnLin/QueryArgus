# Cosmos DB (MongoDB API) — standalone access via DefaultAzureCredential
# Optional: override with an explicit access token (e.g. inside Docker)
# AZURE_ACCESS_TOKEN=

# Cosmos DB (MongoDB API) — direct connection-string fallback for local/emulator
# COSMOS_CONNECTION_STRING=mongodb://localhost:10255/?ssl=true

# Local Cosmos emulator shortcut (mirrors QueryMCPal's QUERYMCPAL_EMULATOR flag)
# QUERYARGUS_EMULATOR=true

# Azure auth — only needed when invoking the OBO flow from QueryPal context
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# ARM_SCOPE=https://management.azure.com/.default

# LLM (Gemini-only for v1 — see PLAN.md §1 D3)
GEMINI_API_KEY=

# Optional: Postgres for persistent audit reports (weekend 3)
# POSTGRES_URL=postgresql://queryargus:queryargus@localhost:5432/queryargus
